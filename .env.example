# Kozeo Complete Environment Configuration

# GraphQL API Backend Endpoints
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4001/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4001/graphql

# WebSocket Realtime Server Endpoint
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Admin Email Whitelist (Comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=admin@kozeo.com,aashray@kozeo.com,shashwat@kozeo.com

# Payment Gateways
NEXT_PUBLIC_PAYMENT_GATEWAY=Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_CASHFREE_CLIENT_ID=your_cashfree_client_id

# AWS S3 Storage Config
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_aws_access_key
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=kozeo-uploads
